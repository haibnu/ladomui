{
  "name": "@ladom/ui",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Ladom (https://ladom.co)",
  "homepage": "https://ui.ladom.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haibnu/ladomui.git",
    "directory": "packages/ui"
  },
  "description": "Ladom UI React components, built 1:1 from the Ladom UI Figma file.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/bundle-package.mjs --files"
  },
  "dependencies": {
    "@ladom/icons": "workspace:*",
    "@ladom/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
