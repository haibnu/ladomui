{
  "name": "ladomui",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ladom/tokens build && pnpm --filter @ladom/docs dev",
    "typecheck": "pnpm -r typecheck",
    "release": "pnpm -r --filter \"./packages/*\" publish --access public"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
